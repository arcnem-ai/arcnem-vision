BETTER_AUTH_BASE_URL=http://localhost:3000
BETTER_AUTH_SECRET=secret
# Local-only switches. The API refuses to start with either enabled unless
# BETTER_AUTH_BASE_URL is a local http URL. API_DEBUG opens the seeded session
# and relaxes auth checks; the webhook switch allows http and private receivers.
API_DEBUG=true
WEBHOOK_ALLOW_PRIVATE_DESTINATIONS=true
# Required. Set both to false on a deployment unless open registration is intended.
AUTH_ENABLE_SIGN_UP=true
AUTH_ENABLE_ORGANIZATION_CREATION=true
CLIENT_ORIGIN=arcnem-vision://app
DASHBOARD_ORIGIN=http://localhost:3001
TRUSTED_ORIGINS=
REDIS_URL=redis://localhost:6381
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=arcnem-vision
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_USE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/arcnem-vision
INNGEST_APP_ID=arcnem-vision-api
INNGEST_DEV=1
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=
DATABASE_URL=postgres://postgres:postgres@localhost:5480/postgres
MCP_SERVER_URL=http://localhost:3021
# Dashboard collection chat runs in the API server and uses these OpenAI settings.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
RESEND_API_KEY=
TRANSACTIONAL_EMAIL_ADDRESS=
# Encrypts webhook signing secrets at rest. Local development value only; generate a
# separate key for each deployment with `openssl rand -base64 32`.
WEBHOOK_SECRET_ENCRYPTION_KEY=YXJjbmVtLXZpc2lvbi1sb2NhbC1kZXYtb25seS1rZXk=
